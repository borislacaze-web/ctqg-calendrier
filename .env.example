# Copier ce fichier en .env.local et remplir les valeurs
# Ces valeurs se trouvent dans votre projet Supabase :
# → Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_ANON_KEY

# Clé "service_role" (Settings > API > service_role).
# SECRET : ne jamais l'exposer au navigateur. Sert uniquement côté serveur
# à créer / supprimer des comptes depuis la page Administration > Comptes.
SUPABASE_SERVICE_ROLE_KEY=VOTRE_SERVICE_ROLE_KEY

# ── Sauvegarde automatique hebdomadaire (app/api/cron/backup) ──
# Clé API Resend (resend.com — compte gratuit, aucune carte requise).
RESEND_API_KEY=VOTRE_RESEND_API_KEY
# Adresse email qui recevra la sauvegarde chaque semaine.
BACKUP_EMAIL_TO=votre-email@exemple.fr
# Chaîne secrète de votre choix (ex : un mot de passe long aléatoire).
# Empêche quiconque de déclencher la sauvegarde en devinant l'URL.
CRON_SECRET=UNE_CHAINE_SECRETE_AU_HASARD
